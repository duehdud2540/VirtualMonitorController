<Window x:Class="VirtualMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Monitor" Width="860" Height="620" MinWidth="720" MinHeight="540"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged"
        Background="#10141E" Foreground="#EDF2FC" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#DCE8FF"/>
            <Setter Property="Foreground" Value="#142342"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="VIRTUAL MONITOR" Foreground="#92B5FF" FontSize="12"/>
            <TextBlock Text="가상모니터" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,8"/>
            <TextBlock Text="MttVDD 가상 모니터 · 켜기 / 끄기 / 화면 보기" Foreground="#A9B7CC"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#1D283D" CornerRadius="10" Padding="20" Margin="0,24,0,20">
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding CanSelectDevice}" DisplayMemberPath="Label" Margin="0,12,0,4"/>
                <TextBlock Text="{Binding DeviceState}" Foreground="#A9B7CC" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="현재 활성 디스플레이" FontSize="16" Margin="0,0,0,12"/>
            <ListBox x:Name="activeDisplays" ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}" IsEnabled="{Binding CanSelectDevice}" Background="#161E2C" Foreground="#EDF2FC" BorderThickness="0" Padding="12" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{Binding Details}" Foreground="#A9B7CC" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <WrapPanel>
                <Button Content="켜기" Command="{Binding ConnectCommand}"/>
                <Button Content="끄기" Command="{Binding DisconnectCommand}"/>
                <Button Content="확장 모드 적용" Command="{Binding ExtendCommand}"/>
                <Button Content="화면 보기" Command="{Binding PreviewCommand}"/>
                <Button Content="새로 고침" Command="{Binding RefreshCommand}"/>
                <Button Content="가상 모니터 관리" Click="ManageMonitors_Click" IsEnabled="{Binding CanSelectDevice}"/>
            </WrapPanel>
            <TextBlock Text="최소화 또는 X: 트레이로 숨기기 · 앱 종료: 트레이 아이콘 우클릭 → 종료. 가상 뷰는 독립적으로 유지됩니다. 모니터를 끄면 창 위치가 바뀔 수 있습니다." Foreground="#A9B7CC" FontSize="12" Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</Window>
